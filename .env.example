# Public URL where OpenTurnly is reachable. Used in invitation and booking links.
APP_URL=http://localhost:3000

# Port published on your machine by docker-compose.yml.
# OPENTURNLY_PORT=3000

# Port the server listens on inside the container (or on your machine when run from source).
# PORT=3000

# Password of the PostgreSQL database created by docker-compose.yml. Set it before the
# first `docker compose up`: it is applied only when the database is created.
POSTGRES_PASSWORD=change-me

# Connection URL when you run your own PostgreSQL (docker-compose.yml builds it for you).
# Leave it empty in development to use the embedded PostgreSQL (PGlite) in DATA_DIR.
# DATABASE_URL=postgres://openturnly:change-me@localhost:5432/openturnly

# Where the generated secret is stored (and the PGlite database in development).
# Defaults to ./data in development and /data in the Docker image.
# DATA_DIR=./data

# Set to true when OpenTurnly runs behind a reverse proxy (Caddy, Nginx, Cloudflare Tunnel),
# so login and anti-bot limits see each visitor's IP instead of the proxy's.
# TRUST_PROXY=false

# Set to true to let workflows send webhooks to addresses inside your network
# (for example a receiver in the same Docker network). Public addresses always work.
# WEBHOOKS_ALLOW_PRIVATE=false

# A WhatsApp number for this install, if you don't connect one in the panel.
# Set at least the first two. See docs/whatsapp.md.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WABA_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# An email account for this install. Set the first four. See docs/email.md.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# SMTP_PORT=587
# EMAIL_FOOTER=

# Secret used to sign sessions. Optional: if empty, one is generated on first start
# and saved to DATA_DIR/secret. Set it yourself if you keep secrets elsewhere.
# SECRET=
